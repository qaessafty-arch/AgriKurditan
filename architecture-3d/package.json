    "@react-three/postprocessing": "3.0.4",
    "bcryptjs": "3.0.2",
    "framer-motion": "12.23.22",
    "gsap": "3.13.0",
    "next": "15.5.29",
    "nodemailer": "10.6.1",
    "postprocessing": "6.37.8",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "three": "0.180.0",
