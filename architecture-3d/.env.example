# ── Core ───────────────────────────────────────────────────────────────
# Public base URL, used for canonical links, sitemap, emails and CSRF origin checks.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL connection string.
DATABASE_URL="postgresql://arch3d:arch3d_dev@localhost:5432/arch3d?schema=public"

# 32+ random bytes; used to sign password-reset and email tokens. `openssl rand -base64 48`
AUTH_SECRET=""

# ── Storage ────────────────────────────────────────────────────────────
# "local" stores uploads under ./storage (outside the public web root).
# "s3" stores them in any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── AI assistant ───────────────────────────────────────────────────────
# "claude" uses the Anthropic API (requires ANTHROPIC_API_KEY, server-side only).
# "rules" uses the built-in deterministic recommendation engine (no external calls).
AI_PROVIDER="rules"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── Email (SMTP) ───────────────────────────────────────────────────────
# Without SMTP, emails are not sent; the platform says so instead of pretending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Architecture 3D <no-reply@example.com>"
# Address that receives new-lead notifications.
ADMIN_NOTIFY_EMAIL=""

# ── First administrator (used once by `npm run db:seed`) ───────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
